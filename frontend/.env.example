# EUCORA Frontend - Environment Variables Template
# Copy this file to .env and fill in the values

# API Configuration
VITE_API_URL=http://localhost:8000

# Azure AD Authentication
VITE_USE_MOCK_AUTH=false
VITE_ENTRA_CLIENT_ID=your-azure-client-id
VITE_ENTRA_TENANT_ID=your-azure-tenant-id
VITE_REDIRECT_URI=http://localhost:5173/auth/callback

# Demo Mode (Development Only - DO NOT USE IN PRODUCTION)
VITE_DEMO_MODE=false
VITE_DEMO_PASSWORD=admin@134
